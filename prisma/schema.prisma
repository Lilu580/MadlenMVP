generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  image     String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  name          String
  article       String         @unique
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  priceMain     Float
  priceDiscount Float?
  colors        ProductColor[]
  descriptions  Description[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ProductColor {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  nameColor String
  stock     Int            @default(0)
  images    ProductImage[]
}

model ProductImage {
  id       String       @id @default(cuid())
  colorId  String
  color    ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  url      String
  position Int          @default(0)
}

model Description {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  body      String  @db.Text
  position  Int     @default(0)
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  status         OrderStatus @default(PENDING)
  name           String
  surname        String
  email          String
  phone          String
  deliveryType   String
  deliveryData   Json
  paymentMethod  String
  additionalInfo String?
  isCall         Boolean     @default(false)
  items          OrderItem[]
  totalPrice     Float
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  article   String
  image     String
  color     String
  nameColor String
  count     Int
  unitPrice Float
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model SiteSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
